{
	"name": "geminis-labs-web-page",
	"private": true,
	"version": "1.16.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || true && husky",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "prettier --write . && eslint . --fix",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test": "vitest run",
		"validate": "npm run lint && npm run check && npm run test:coverage && npm run build",
		"commitlint": "commitlint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"audit": "npm audit --audit-level=high",
		"scan:secrets": "bash scripts/gitleaks-scan.sh",
		"scan:osv": "bash scripts/osv-scan.sh"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/svelte": "^5.4.2",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"husky": "^9.1.7",
		"jsdom": "^30.1.1",
		"lint-staged": "^17.6.0",
		"playwright": "^1.65.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.2.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@googlemaps/js-api-loader": "^2.1.3",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/context-async-hooks": "^3.1.1",
		"@opentelemetry/core": "^3.1.1",
		"@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
		"@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
		"@opentelemetry/instrumentation": "^0.301.2",
		"@opentelemetry/instrumentation-fetch": "^0.301.2",
		"@opentelemetry/instrumentation-http": "^0.301.2",
		"@opentelemetry/resources": "^3.1.1",
		"@opentelemetry/sdk-logs": "^3.1.1",
		"@opentelemetry/sdk-metrics": "^3.1.1",
		"@opentelemetry/sdk-trace": "^3.1.1",
		"@opentelemetry/semantic-conventions": "^1.45.0",
		"@stripe/stripe-js": "^9.16.0",
		"pixi.js": "^8.22.0"
	},
	"overrides": {
		"cookie": ">=0.7.0",
		"serialize-javascript": ">=6.0.2",
		"tar": ">=6.2.1",
		"esbuild": ">=0.25.0",
		"postcss": ">=8.5.18",
		"brace-expansion": ">=5.0.8",
		"fast-uri": ">=4.1.2",
		"js-yaml": ">=4.3.0",
		"minimatch": ">=10.2.6",
		"nanoid": "^3.3.18",
		"devalue": "^5.9.4",
		"@tailwindcss/typography": {
			"postcss-selector-parser": "^6.1.6"
		}
	}
}
