# Variables de Entorno - Geminis Labs Web Page
# Copia este archivo como .env y configura tus valores

# API Base URL
# URL base de tu API backend (sin trailing slash)
# Ejemplo: https://api.geminislabs.com
# Desarrollo local: siscom-admin-api (mismo backend que Nexus)
# Ejemplo producción: https://api.geminislabs.com
VITE_API_BASE_URL=http://127.0.0.1:8100

# Google Maps API Key (opcional, si usas mapas)
VITE_GOOGLE_MAPS_API_KEY=tu_api_key_aqui

# Orion API URL (sin trailing slash)
# Ejemplo: https://api.orion.geminislabs.com
VITE_ORION_API_URL=http://localhost:8080

# Observabilidad (opcional). En local, si no se define, se usa http://localhost:4318.
# OTLP_ENDPOINT= desactiva el export. En production/test hay que setearlo.
# No uses prefijo VITE_: no debe ir al bundle como URL de collector.
# Collector local: cd observability/local && docker compose up -d
# OTLP_ENDPOINT=http://localhost:4318
